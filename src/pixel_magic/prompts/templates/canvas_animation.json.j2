{
  "image_type": "sprite_sheet",
  "purpose": "character_animation",
  "layout": {
    "arrangement": "{{ layout_desc }}",
    "total_frames": {{ total_frames }},
    "background": {
      "color": "{{ chromakey_color }}",
      "hex": "{{ hex_color }}"
    }
  },
  "reference_image": {
    "description": "The FIRST attached image is a clean standalone view of the character. Use it as the definitive reference for proportions, colors, outfit, and style."
  },
  {% if platform %}
  "platform": {
    "type": "{{ floor_desc }}",
    {% if loop %}
    "slot_description": "The FIRST and LAST slots show a pixel art character standing on {{ floor_desc }}. The {{ middle_count }} middle slots each have the same floor but NO character.",
    {% else %}
    "slot_description": "The FIRST slot shows a pixel art character standing on {{ floor_desc }}. The remaining {{ total_frames - 1 }} slots each have the same floor but NO character.",
    {% endif %}
    "rules": [
      "Do NOT modify the stone platforms — draw the character standing ON TOP of them",
      "The character's feet must rest on the platform surface in every frame",
      "Maintain the isometric 3/4 top-down perspective — the platform establishes the ground plane"
      {% if tiles > 1 %}
      ,"The character has extra floor space — use it for the full range of motion (extended limbs, weapon swings, lunges)"
      {% endif %}
    ]
  },
  {% endif %}
  {% if batch_index > 0 %}
  "batch_context": {
    "batch": "{{ batch_index + 1 }} of {{ total_batches }}",
    "continuation": "The FIRST image is the clean character reference. The SECOND image shows the previously generated frames. The THIRD image is the canvas to fill.",
    "consistency": "Match the character's proportions, colors, outfit, and pixel art style EXACTLY as shown in the reference and previous frames."
    {% if is_final_batch and loop %}
    ,"final_segment": "This is the FINAL segment. The animation must smoothly return to the original starting pose by the last frame. The last frame must match the pose in frame 1 of the first batch."
    {% endif %}
  },
  {% endif %}
  "animation": {
    "description": "{{ animation_description | je }}",
    "total_animation_frames": {{ global_total_frames }},
    {% if batch_index == 0 and loop and total_batches == 1 %}
    "looping": true,
    "image_order": "Image 1 = clean character reference. Image 2 = canvas template to fill.",
    "instruction": "The FIRST and LAST slots both show the same character pose — this is a LOOPING animation. Fill in the {{ middle_count }} middle slots (slots 2–{{ total_frames - 1 }}) with animation frames that smoothly transition from the first pose, through the full motion, and back to the same pose.",
    "anchor_rule": "Do NOT modify the first or last slot — they are identical anchor poses for the loop. The animation must smoothly cycle: frame {{ total_frames }} flows back into frame 1."
    {% elif batch_index == 0 %}
    "looping": {{ 'true' if loop else 'false' }},
    "image_order": "Image 1 = clean character reference. Image 2 = canvas template to fill.",
    "instruction": "The FIRST slot contains the starting pose (frame 1). Fill in the remaining {{ total_frames - 1 }} slots with animation frames that begin the described animation.",
    "anchor_rule": "Do NOT modify the first slot — it is the reference frame, leave it exactly as-is."
    {% elif is_final_batch and loop %}
    "looping": true,
    "instruction": "The FIRST slot shows the last frame from the previous batch (for continuity). Fill the remaining slots, smoothly returning to the original starting pose. The LAST slot must match frame 1 exactly.",
    "anchor_rule": "Do NOT modify the first slot — it is the overlap frame from the previous batch. Do NOT modify the last slot — it is the loop-closure frame matching the original pose."
    {% else %}
    "looping": {{ 'true' if loop else 'false' }},
    "instruction": "The FIRST slot shows the last frame from the previous batch (for continuity). Fill the remaining {{ total_frames - 1 }} slots continuing the described animation smoothly.",
    "anchor_rule": "Do NOT modify the first slot — it is the overlap frame from the previous batch, leave it exactly as-is."
    {% endif %}
  },
  {% if frame_poses_data %}
  "frames": [
    {% for frame in frame_poses_data %}
    {"slot": {{ frame.slot }}, "pose": "{{ frame.pose | je }}"{{ ', "anchor": true' if frame.get("anchor") else '' }}}{{ ',' if not loop.last else '' }}
    {% endfor %}
  ],
  {% endif %}
  "spatial_rules": {
    "default_behavior": "Unless the animation description or frame poses explicitly indicate otherwise:",
    "rules": [
      {% for rule in spatial_rules %}
      "{{ rule | je }}"{{ ',' if not loop.last else '' }}
      {% endfor %}
    ]
  },
  {% if character_description %}
  "character": {
    "description": "{{ character_description | je }}"
  },
  {% endif %}
  "rules": [
    "Draw the SAME character {{ 'on each platform' if platform else 'in each slot' }} — identical proportions, colors, outfit, pixel art style",
    "Each filled slot must show a DIFFERENT pose progressing through the animation",
    "Each empty slot has a small white number in the top-left corner showing its frame position — use these numbers to maintain correct animation sequence order"
    {% if not platform %}
    ,"Only draw inside the {{ chromakey_color }} areas"
    ,"Keep the {{ chromakey_color }} ({{ hex_color }}) background within each frame slot"
    {% endif %}
  ],
  "art_details": {
    "style": "{{ style | je }}",
    "perspective": "isometric 3/4 top-down view",
    "pixel_art": "hard pixel edges, no anti-aliasing, no smoothing",
    "outline": "1-pixel black outline on all character elements",
    "palette": "same color palette across all frames"
    {% if platform %}
    ,"background": "{{ chromakey_color }} ({{ hex_color }}) background must remain around the character and platform"
    {% endif %}
  }
}
