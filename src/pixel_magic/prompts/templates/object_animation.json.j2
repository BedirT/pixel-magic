{
  "image_type": "sprite_sheet",
  "purpose": "object_animation",
  "layout": {
    "arrangement": "{{ layout_desc }}",
    "total_frames": {{ total_frames }},
    "background": {
      "color": "{{ chromakey_color }}",
      "hex": "{{ hex_color }}"
    }
  },
  {% if platform %}
  "platform": {
    "type": "{{ floor_desc }}",
    {% if loop %}
    "slot_description": "The FIRST and LAST slots show a pixel art object sitting on {{ floor_desc }}. The {{ middle_count }} middle slots each have the same floor but NO object.",
    {% else %}
    "slot_description": "The FIRST slot shows a pixel art object sitting on {{ floor_desc }}. The remaining {{ total_frames - 1 }} slots each have the same floor but NO object.",
    {% endif %}
    "rules": [
      "Do NOT modify the stone platforms — draw the object sitting ON TOP of them",
      "The object's base must rest on the platform surface in every frame",
      "Maintain the isometric 3/4 top-down perspective — the platform establishes the ground plane"
    ]
  },
  {% endif %}
  "animation": {
    "type": "{{ animation_type }}",
    "description": "{{ anim_desc }}",
    {% if loop %}
    "looping": true,
    "instruction": "The FIRST and LAST slots both show the same object — this is a LOOPING animation. Fill in the {{ middle_count }} middle slots (slots 2–{{ total_frames - 1 }}) with animation frames that smoothly transition from the first pose, through the full motion, and back to the same pose.",
    "anchor_rule": "Do NOT modify the first or last slot — they are identical anchor frames for the loop. The animation must smoothly cycle: frame {{ total_frames }} flows back into frame 1."
    {% else %}
    "looping": false,
    "instruction": "The FIRST slot contains the starting state. Fill in the remaining {{ total_frames - 1 }} slots with animation frames.",
    "anchor_rule": "Do NOT modify the first slot — it is the reference frame, leave it exactly as-is."
    {% endif %}
  },
  {% if object_description %}
  "object": {
    "description": "{{ object_description }}"
  },
  {% endif %}
  "rules": [
    "Draw the SAME object {{ 'on each platform' if platform else 'in each slot' }} — identical base shape, colors, proportions, pixel art style",
    "Each filled slot must show a DIFFERENT state progressing through the animation",
    "Each empty slot has a small white number in the top-left corner showing its frame position — use these numbers to maintain correct animation sequence order"
    {% if not platform %}
    ,"Only draw inside the {{ chromakey_color }} areas"
    ,"Keep the {{ chromakey_color }} ({{ hex_color }}) background within each frame slot"
    {% endif %}
  ],
  "art_details": {
    "style": "{{ style }}",
    "perspective": "isometric 3/4 top-down view",
    "pixel_art": "hard pixel edges, no anti-aliasing, no smoothing",
    "outline": "1-pixel black outline on all object elements",
    "palette": "same color palette across all frames"
    {% if platform %}
    ,"background": "{{ chromakey_color }} ({{ hex_color }}) background must remain around the object and platform"
    {% endif %}
  }
}
